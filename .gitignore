
# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/


# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest.toml
# Exception: probe/repro envs DO need their Manifest.toml committed for reproducibility
# (they pin exact package versions to reproduce specific benchmark states).
!repro/polish_regression_2026_05_19/env_*/Manifest.toml

# Temporary test files and output
*.log
# Root-anchored: scratch test scripts at repo root only. An unanchored
# `test_*.jl` silently ignored every NEW file under test/ (each `!` exception
# below was a prior victim of that trap). All tracked test/deprecated files
# are unaffected by anchoring.
/test_*.jl
!repro/multiplicity_complete_2026_05_19/test_compute_M.jl
!repro/multiplicity_complete_2026_05_19/test_patched_sian.jl
tmp/


# Generated system saves
saved_systems/
scripts/saved_systems/

# Temporary debug scripts
scripts/diagnostics_debug.jl
quick_rs_test.jl
debug_*.jl
debug_*.log

# Working notes
fix_summary.md
full_test_output.log

# Editor swap/backup files
*.swp
*.swo
*~

# Claude tooling artifacts
.claude/
.codex
claude_dir/
claude_analysis/

# Local agent scratch/planning output
temp_plans/

# Generated synthesis diagnostics
artifacts/diagnostics/**/synthesis_log.csv
artifacts/branch_selection_experiments_2026_05_21/

# Retained iterative-fixing audit artifacts
artifacts/iterfix_audit/

# Repro session run logs / intermediate artifacts — keep code + final results,
# skip the verbose Julia stdout/stderr and the per-cell intermediate artifacts
# subdirectories produced during diagnostic runs.
repro/**/stdout.txt
repro/**/stderr.txt
repro/**/artifacts/
# Research sources are maintained on the research branch. Preserve local run
# output left by branch switches without adding it to the installable main tree.
/repro/
# Audited campaigns write an atomic record before estimation. Keep their
# resumable runtime directories out of worktree-dirty checks; promote final
# summaries deliberately with `git add -f` when they belong in the record.
repro/uq_coverage_harness_2026_08/results/audited_*/
*_06_lost_recheck.out
*_06_lost_recheck.err

# LaTeX build artifacts
*.aux
*.toc
*.synctex.gz

# --- Standard artifact ignores (git-hygiene pass) ---
# Generic coverage output (complements *.jl.cov / *.jl.*.cov above)
*.cov

# OS-generated cruft
.DS_Store
Thumbs.db

# Python benchmark tooling
__pycache__/

# Patch / merge-conflict leftovers
*.orig
*.rej

# Additional Vim swap suffix (complements *.swp / *.swo above)
*.swn

# Regenerated by feature_regressions on every gate run (timestamps churn);
